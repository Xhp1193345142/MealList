{
  "name": "meal-list",
  "version": "0.1.0",
  "private": true,
  "description": "MealList — 从菜谱到开饭，一张清单搞定。",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev:app": "pnpm --filter @meallist/app start",
    "dev:api": "pnpm --filter @meallist/api start:dev",
    "dev:mini": "pnpm --filter @meallist/miniprogram dev:weapp",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:dev:up": "docker compose --env-file .env.development -f infra/docker-compose.yml up -d postgres",
    "db:preview:up": "docker compose --env-file .env.preview -f infra/docker-compose.yml up -d postgres",
    "db:production-local:up": "docker compose --env-file .env.production.local -f infra/docker-compose.yml up -d postgres"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
